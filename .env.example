# ============================================================
# RCGA Digital Platform — Environment Variables
# ============================================================

# Security
SECRET_KEY=rcga-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rcga_db

# Local SQLite alternative (if PostgreSQL is not yet running locally):
# DATABASE_URL=sqlite:///./backend/rcga.db

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379/0

# External AI Services (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,*

# File Storage Configuration (Local or MinIO/S3)
STORAGE_BACKEND=local
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=25

# MinIO / AWS S3 Settings (when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=rcga-media
# S3_REGION_NAME=us-east-1
# S3_PUBLIC_URL_PREFIX=http://localhost:9000/rcga-media


